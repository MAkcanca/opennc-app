import { ComboBox, Palette } from "std-widgets.slint";
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";

export global Theme {
    out property <color> bg: #0f1117;
    out property <color> card: #171a23;
    out property <color> card-border: #242836;
    out property <color> track: #232733;
    out property <color> text: #e6e8ef;
    out property <color> muted: #8b90a0;
    out property <color> faint: #5b6070;
    out property <color> accent: #6366f1;
    out property <color> accent2: #22d3ee;
    out property <color> ok: #22c55e;
    out property <color> warn: #eab308;
    out property <color> danger: #ef4444;
}

component Card inherits Rectangle {
    background: Theme.card;
    border-color: Theme.card-border;
    border-width: 1px;
    border-radius: 12px;
}

component Label inherits Text {
    color: Theme.muted;
    font-size: 12px;
    font-weight: 500;
}

component Button inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked;
    height: 32px;
    width: lay.preferred-width;
    border-radius: 8px;
    background: root.primary ? (ta.has-hover ? Theme.accent.brighter(0.15) : Theme.accent) : (ta.has-hover ? #2a2f3d : Theme.track);
    animate background { duration: 150ms; }
    lay := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text { text: root.label; color: root.primary ? white : Theme.text; font-size: 12px; font-weight: 500; vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Meter inherits VerticalLayout {
    in property <string> label;
    in property <float> level;   // 0..1
    in property <string> value;  // "-42 dB"
    in property <brush> fill: @linear-gradient(90deg, Theme.ok, Theme.warn);
    spacing: 6px;
    HorizontalLayout {
        Label { text: root.label; }
        Rectangle { }
        Label { text: root.value; font-weight: 400; horizontal-alignment: right; }
    }
    Rectangle {
        height: 8px;
        border-radius: 4px;
        background: Theme.track;
        Rectangle {
            x: 0;
            height: parent.height;
            width: parent.width * root.level;
            border-radius: 4px;
            background: root.fill;
            animate width { duration: 120ms; easing: ease-out; }
        }
    }
}

// Layered so every transition is an opacity crossfade (brush-to-gradient interpolation is not smooth):
// glow (shadow only) -> dark base -> gradient face -> icon.
component PowerButton inherits Rectangle {
    in property <bool> active;
    in property <bool> busy;
    callback clicked;
    property <length> size: ta.pressed && !root.busy ? 90px : 96px;
    property <float> on: root.active ? 1.0 : 0.0;
    width: 96px;
    height: 96px;
    glow := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.size;
        height: root.size;
        border-radius: self.width / 2;
        background: Theme.accent;
        drop-shadow-blur: 30px;
        drop-shadow-color: Theme.accent.with-alpha(0.6);
        opacity: root.on;
        animate opacity { duration: 360ms; easing: ease-in-out; }
        animate width, height { duration: 120ms; easing: ease-out; }
    }
    base := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.size;
        height: root.size;
        border-radius: self.width / 2;
        background: ta.has-hover && !root.active && !root.busy ? #262b3a : #1f2330;
        border-width: 2px;
        border-color: ta.has-hover && !root.active && !root.busy ? #3a4050 : #2d3242;
        animate background, border-color { duration: 150ms; }
        animate width, height { duration: 120ms; easing: ease-out; }
    }
    face := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.size;
        height: root.size;
        border-radius: self.width / 2;
        background: @linear-gradient(135deg, Theme.accent, Theme.accent2);
        opacity: root.on;
        animate opacity { duration: 360ms; easing: ease-in-out; }
        animate width, height { duration: 120ms; easing: ease-out; }
    }
    Path {
        width: 36px;
        height: 36px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 18.36 6.64 A 9 9 0 1 1 5.64 6.64 M 12 2 L 12 12";
        stroke: root.active ? white : Theme.muted;
        stroke-width: 2.2px;
        fill: transparent;
        opacity: root.busy ? 0.6 : 1.0;
        animate stroke { duration: 360ms; easing: ease-in-out; }
        animate opacity { duration: 150ms; }
    }
    ta := TouchArea {
        enabled: !root.busy;
        mouse-cursor: root.busy ? default : pointer;
        clicked => { root.clicked(); }
    }
}

component StrengthSlider inherits Rectangle {
    in-out property <float> value: 100; // 0..100
    callback changed(float);
    height: 24px;
    property <length> knob: 18px;
    property <length> usable: root.width - root.knob;
    function set-from-x(x: length) {
        root.value = max(0, min(100, (x - root.knob / 2) / root.usable * 100));
        root.changed(root.value);
    }
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 6px;
        border-radius: 3px;
        background: Theme.track;
        Rectangle {
            x: 0;
            height: parent.height;
            width: root.knob / 2 + root.usable * root.value / 100;
            border-radius: 3px;
            background: @linear-gradient(90deg, Theme.accent, Theme.accent2);
        }
    }
    knob-rect := Rectangle {
        x: root.usable * root.value / 100;
        y: (parent.height - self.height) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: white;
        drop-shadow-blur: ta.has-hover || ta.pressed ? 10px : 6px;
        drop-shadow-color: ta.pressed ? Theme.accent.with-alpha(0.6) : #00000080;
        animate drop-shadow-blur, drop-shadow-color { duration: 150ms; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        moved => { if (self.pressed) { root.set-from-x(self.mouse-x); } }
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.set-from-x(self.mouse-x); } }
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? Theme.accent : #2a2f3d;
    animate background { duration: 200ms; easing: ease-in-out; }
    Rectangle {
        x: root.checked ? root.width - self.width - 3px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: white;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000060;
        animate x { duration: 200ms; easing: ease-in-out; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; root.toggled(root.checked); }
    }
}

// A line of text that crossfades between two fixed strings instead of re-wrapping: nothing ever moves.
component CrossfadeText inherits Rectangle {
    in property <string> off-text;
    in property <string> on-text;
    in property <bool> on;
    in property <length> font-size: 13px;
    in property <int> font-weight: 400;
    in property <color> text-color: Theme.text;
    Text {
        width: 100%;
        height: 100%;
        text: root.off-text;
        color: root.text-color;
        font-size: root.font-size;
        font-weight: root.font-weight;
        horizontal-alignment: center;
        vertical-alignment: top;
        wrap: word-wrap;
        overflow: elide;
        opacity: root.on ? 0.0 : 1.0;
        // outgoing text fades first, the incoming one follows: never two strings on top of each other
        animate opacity { duration: 170ms; delay: root.on ? 0ms : 170ms; easing: ease-in-out; }
    }
    Text {
        width: 100%;
        height: 100%;
        text: root.on-text;
        color: root.text-color;
        font-size: root.font-size;
        font-weight: root.font-weight;
        horizontal-alignment: center;
        vertical-alignment: top;
        wrap: word-wrap;
        overflow: elide;
        opacity: root.on ? 1.0 : 0.0;
        animate opacity { duration: 170ms; delay: root.on ? 170ms : 0ms; easing: ease-in-out; }
    }
}

export component AppWindow inherits Window {
    title: "OpenNC";
    icon: @image-url("icon.png");
    width: 400px;
    height: 800px;
    background: Theme.bg;
    default-font-family: "Inter";
    default-font-size: 13px;

    in property <[string]> inputs;
    in property <[string]> outputs;
    in-out property <string> mic;
    in-out property <string> output;
    in-out property <float> strength: 100;
    in property <bool> active;
    in property <bool> busy;
    in property <bool> waiting;          // device went away, will resume when it is back
    in property <float> mic-level;
    in property <float> clean-level;
    in property <string> mic-db: "";
    in property <string> clean-db: "";
    in property <string> idle-message: "";
    in property <string> live-message: "";
    in property <string> notice: "";          // shown instead of the messages, muted (e.g. waiting for a device)
    in property <string> error-message: "";
    in property <bool> error: false;
    in property <bool> cable-missing: false;
    in property <string> update-version: ""; // non-empty: an update is available
    in property <bool> updating: false;
    in-out property <bool> start-with-windows;
    in-out property <bool> auto-on;
    in property <string> version: "OpenNC v1  ·  48 kHz  ·  10 ms frames";

    callback toggle();
    callback mic-changed(string);
    callback output-changed(string);
    callback strength-changed(float);
    callback refresh-devices();
    callback get-cable();
    callback install-update();
    callback set-start-with-windows(bool);
    callback set-auto-on(bool);

    init => { Palette.color-scheme = ColorScheme.dark; }

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // header
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: @linear-gradient(135deg, Theme.accent, Theme.accent2);
                Text { text: "N"; color: white; font-weight: 700; font-size: 14px; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
            }
            Text { text: "OpenNC"; color: Theme.text; font-size: 18px; font-weight: 600; vertical-alignment: center; }
            Rectangle { }
        }

        // update banner
        if root.update-version != "": Rectangle {
            height: 44px;
            border-radius: 10px;
            background: Theme.accent.with-alpha(0.14);
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.5);
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 8px;
                spacing: 10px;
                Text { text: "OpenNC \{root.update-version} is available"; color: Theme.text; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                Rectangle { }
                Button { label: root.updating ? "Downloading" : "Install"; primary: true; y: (parent.height - self.height) / 2; height: 28px; clicked => { if (!root.updating) { root.install-update(); } } }
            }
        }

        // hero
        VerticalLayout {
            spacing: 10px;
            padding-top: 6px;
            HorizontalLayout { alignment: center; PowerButton { active: root.active; busy: root.busy; clicked => { root.toggle(); } } }
            Rectangle {
                height: 22px;
                CrossfadeText {
                    width: 100%;
                    height: 100%;
                    off-text: "Noise cancellation is off";
                    on-text: "Noise cancellation is on";
                    on: root.active;
                    font-size: 15px;
                    font-weight: 500;
                    opacity: root.waiting ? 0.0 : 1.0;
                    animate opacity { duration: 200ms; }
                }
                Text {
                    width: 100%;
                    height: 100%;
                    text: "Waiting for your microphone";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: top;
                    opacity: root.waiting ? 1.0 : 0.0;
                    animate opacity { duration: 200ms; }
                }
            }
            Rectangle {
                height: 36px; // always two lines tall, so the cards below never move
                CrossfadeText {
                    width: 100%;
                    height: 100%;
                    off-text: root.idle-message;
                    on-text: root.live-message;
                    on: root.active;
                    font-size: 12px;
                    text-color: Theme.muted;
                    opacity: root.error || root.notice != "" ? 0.0 : 1.0;
                    animate opacity { duration: 200ms; }
                }
                Text {
                    width: 100%;
                    height: 100%;
                    text: root.error ? root.error-message : root.notice;
                    color: root.error ? Theme.danger : Theme.muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: top;
                    wrap: word-wrap;
                    overflow: elide;
                    opacity: root.error || root.notice != "" ? 1.0 : 0.0;
                    animate opacity { duration: 200ms; }
                }
            }
        }

        // first-run: no virtual cable
        if root.cable-missing: Card {
            border-color: Theme.accent.with-alpha(0.6);
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: "Set up the virtual microphone"; color: Theme.text; font-size: 14px; font-weight: 600; }
                Text {
                    text: "Other apps cannot read OpenNC's output directly. Install VB-Cable (free), choose \"CABLE Input\" below, then pick \"CABLE Output\" as the microphone in your apps.";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button { label: "Get VB-Cable"; primary: true; clicked => { root.get-cable(); } }
                    Button { label: "Check again"; clicked => { root.refresh-devices(); } }
                    Rectangle { }
                }
            }
        }

        // meters
        Card {
            VerticalLayout {
                padding: 16px;
                spacing: 14px;
                Meter { label: "Microphone"; level: root.mic-level; value: root.mic-db; fill: @linear-gradient(90deg, #64748b, #94a3b8); }
                Meter { label: "Clean output"; level: root.clean-level; value: root.clean-db; }
            }
        }

        // devices
        Card {
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Label { text: "Microphone"; }
                ComboBox { model: root.inputs; current-value: root.mic; enabled: !root.active && !root.busy; selected(v) => { root.mic = v; root.mic-changed(v); } }
                Rectangle { height: 4px; }
                Label { text: "Send clean audio to"; }
                ComboBox { model: root.outputs; current-value: root.output; enabled: !root.active && !root.busy; selected(v) => { root.output = v; root.output-changed(v); } }
                HorizontalLayout {
                    alignment: end;
                    Rectangle {
                        width: refresh.width;
                        height: refresh.height;
                        refresh-ta := TouchArea { mouse-cursor: pointer; enabled: !root.active && !root.busy; clicked => { root.refresh-devices(); } }
                        refresh := Text { text: "Refresh devices"; color: refresh-ta.has-hover ? Theme.text : Theme.faint; font-size: 12px; animate color { duration: 150ms; } }
                    }
                }
            }
        }

        // strength
        Card {
            VerticalLayout {
                padding: 16px;
                spacing: 6px;
                HorizontalLayout {
                    Label { text: "Suppression"; }
                    Rectangle { }
                    Label { text: "\{round(root.strength)}%"; font-weight: 400; }
                }
                StrengthSlider { value <=> root.strength; changed(v) => { root.strength-changed(v); } }
            }
        }

        // behaviour
        Card {
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 4px;
                HorizontalLayout {
                    Text { text: "Start with Windows"; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                    Rectangle { }
                    Toggle { checked <=> root.start-with-windows; toggled(v) => { root.set-start-with-windows(v); } }
                }
                Rectangle { height: 6px; }
                HorizontalLayout {
                    Text { text: "Turn on when OpenNC starts"; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                    Rectangle { }
                    Toggle { checked <=> root.auto-on; toggled(v) => { root.set-auto-on(v); } }
                }
            }
        }

        Rectangle { }
        Text { text: root.version; color: Theme.faint; font-size: 11px; horizontal-alignment: center; }
    }
}
